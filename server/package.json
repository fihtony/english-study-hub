{
  "name": "server",
  "version": "1.0.0",
  "description": "Express backend for Constellation CSTL-4 feature. Provides lightweight API and health endpoints used by the client.",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nodemon src/index.js --watch src --ext js,json",
    "start": "node src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll"
  },
  "keywords": [
    "express",
    "api",
    "constellation",
    "cstl-4"
  ],
  "author": "Constellation Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}