# Example environment variables for the Express server.
# Copy this file to .env and update values for your environment.
# Do NOT commit real secrets. Use a secrets manager for production.

# Server / Runtime
PORT=4000
NODE_ENV=development
APP_HOST=0.0.0.0
APP_NAME=constellation-server

# Security (replace these with strong secrets in production)
# Use a secure, randomly generated value for SESSION_SECRET and JWT_SECRET.
SESSION_SECRET=change_me_replace_with_strong_secret
JWT_SECRET=change_me_replace_with_strong_jwt_secret
JWT_EXPIRES_IN=1h

# Database (example PostgreSQL URL for local development)
DATABASE_URL=postgres://user:password@localhost:5432/constellation_dev

# CORS - set to the frontend origin(s) allowed to access the API
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# Optional integrations
SENTRY_DSN=
ANALYTICS_KEY=

# Feature flags
ENABLE_TELEMETRY=false

# Notes:
# - For production, set NODE_ENV=production and provide real secrets.
# - Never store production secrets in source control. Use environment-specific secret storage.