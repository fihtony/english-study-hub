<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800" role="img" aria-labelledby="title desc">
  <title id="title">Hero placeholder image</title>
  <desc id="desc">A lightweight decorative placeholder for the landing hero area. Replace with real Stitch asset when available.</desc>

  <!-- Design tokens-inspired palette (surface-container and primary) -->
  <defs>
    <linearGradient id="gPrimary" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#0B5FFF" stop-opacity="1"/>
      <stop offset="1" stop-color="#4EA1FF" stop-opacity="1"/>
    </linearGradient>

    <linearGradient id="gAccent" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#8ED1FF" stop-opacity="0.9"/>
      <stop offset="1" stop-color="#CDE9FF" stop-opacity="0.9"/>
    </linearGradient>

    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="18" result="b"/>
      <feBlend in="SourceGraphic" in2="b"/>
    </filter>

    <style type="text/css"><![CDATA[
      .bg { fill: #F1F7FF; }                /* surface-container token */
      .card { fill: url(#gAccent); opacity: 0.95; stroke: none; }
      .blob { fill: url(#gPrimary); filter: url(#soft); opacity: 0.95; }
      .line { stroke: rgba(255,255,255,0.35); stroke-width: 6; stroke-linecap: round; }
      .title { fill: #07386A; font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; font-weight: 700; font-size: 36px; }
      .subtitle { fill: #0F4A78; font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial; font-size: 18px; opacity: 0.9; }
    ]]></style>
  </defs>

  <!-- Background surface -->
  <rect class="bg" width="1200" height="800" rx="0"/>

  <!-- Decorative left card -->
  <g transform="translate(70,120)">
    <rect class="card" x="0" y="0" rx="18" width="520" height="560"/>
    <g transform="translate(28,28)">
      <rect x="0" y="0" width="200" height="28" rx="6" fill="#FFFFFF" opacity="0.14"/>
      <rect x="0" y="48" width="340" height="18" rx="6" fill="#FFFFFF" opacity="0.10"/>
      <rect x="0" y="82" width="300" height="14" rx="6" fill="#FFFFFF" opacity="0.08"/>
      <rect x="0" y="110" width="420" height="14" rx="6" fill="#FFFFFF" opacity="0.06"/>
      <!-- Mock content cards -->
      <g transform="translate(0,150)">
        <rect x="0" y="0" width="480" height="42" rx="10" fill="#FFFFFF" opacity="0.06"/>
        <rect x="0" y="62" width="420" height="42" rx="10" fill="#FFFFFF" opacity="0.06"/>
        <rect x="0" y="124" width="360" height="42" rx="10" fill="#FFFFFF" opacity="0.06"/>
      </g>
    </g>
  </g>

  <!-- Right-side hero blob / focal -->
  <g transform="translate(640,120)">
    <ellipse class="blob" cx="220" cy="220" rx="260" ry="220" />
    <ellipse class="blob" cx="80" cy="360" rx="140" ry="100" opacity="0.8" />
    <rect x="40" y="120" width="360" height="260" rx="16" fill="#FFFFFF" opacity="0.06"/>
    <!-- Stylized lines -->
    <path class="line" d="M40 140 C160 80, 300 60, 380 140" />
    <path class="line" d="M60 260 C180 200, 320 180, 380 260" />
  </g>

  <!-- Foreground text block (represents hero copy) -->
  <g transform="translate(120,720)">
    <text class="title" x="0" y="-150">Hero placeholder</text>
    <text class="subtitle" x="0" y="-115">This image is a lightweight placeholder. Replace with the Stitch-provided asset (screen ID: 45ac4478a1b7455f861d7377f92105e6).</text>
  </g>

  <!-- Accessible fallback rectangle for strict renderers -->
  <rect x="0" y="0" width="1200" height="800" fill="none" aria-hidden="true"/>
</svg>