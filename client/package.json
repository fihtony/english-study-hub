{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "description": "React frontend for Constellation (CSTL) - Vite + React + Vitest + Playwright",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist",
    "preview": "vite preview --port 5173",
    "start": "vite preview --port 5173",
    "test": "vitest",
    "test:ci": "vitest --run --reporter=dot",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "e2e:playwright-run": "npx playwright test",
    "playwright:install": "npx playwright install --with-deps",
    "prepare": "npx playwright install --with-deps"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.1",
    "clsx": "^1.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "playwright": "^1.38.0",
    "vitest": "^1.2.0",
    "vite": "^5.1.0"
  },
  "vitest": {
    "globals": true,
    "environment": "jsdom",
    "coverage": {
      "provider": "c8",
      "reports": [
        "text",
        "lcov"
      ],
      "exclude": [
        "e2e/**",
        "node_modules/**"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fihtony/english-study-hub"
  },
  "keywords": [
    "react",
    "vite",
    "constellation",
    "cstl-4"
  ],
  "license": "MIT"
}